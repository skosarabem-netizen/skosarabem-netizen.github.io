---
interface Props { id: string; title?: string }
const { id, title = 'Video' } = Astro.props;
---
<figure class="fig embed"><iframe src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`} title={title} loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></figure>
