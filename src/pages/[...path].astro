---
// Every project file becomes a case-study page at its own `path` (same addresses as the old site).
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { mdxComponents } from '../components/mdx';
import { allProjects, url, media, type Project } from '../lib/projects';

export async function getStaticPaths() {
  const projects = await allProjects();
  return projects.map(p => ({ params: { path: p.data.path }, props: { project: p, projects } }));
}

interface Props { project: Project; projects: Project[] }
const { project, projects } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const parent = d.parent ? projects.find(p => p.id === d.parent) : undefined;
const children = projects.filter(p => p.data.parent === project.id);
const siblings = parent ? projects.filter(p => p.data.parent === parent.id && p.id !== project.id) : [];
// "Next project" walks through work, then archive
const sequence = projects.filter(p => p.data.kind !== 'sub');
const next = d.kind !== 'sub' ? sequence[(sequence.indexOf(project) + 1) % sequence.length] : undefined;
const pills = [d.role, d.years, ...d.tags].filter(Boolean);
---
<Base title={`${d.title} – Swapnil Kosarabe`} description={d.summary} image={media(d.cover)}>
  <article class="cs">
    <header class="cs-hero">
      <p class="eyebrow">
        {parent ? <a href={url(parent)}>{parent.data.title}</a> : d.org}
        {parent ? ' · Deep dive' : d.kind === 'archive' ? ' · Archive' : ''}
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {pills.length > 0 && <ul class="pills">{pills.map(t => <li>{t}</li>)}</ul>}
      {d.link && <p><a class="arrow-link" href={d.link} target="_blank" rel="noopener">Visit live product</a></p>}
    </header>
    {d.cover && (
      <figure class="cs-cover"><img src={media(d.cover)} alt="" fetchpriority="high" /></figure>
    )}

    {children.length > 0 && (
      <nav class="deep-dives" aria-label="Deep dives">
        <p class="eyebrow">Deep dives</p>
        <div class="dd-grid">
          {children.map((c, i) => (
            <a class="dd" href={url(c)}>
              <span class="eyebrow num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{c.data.title}</strong>
              <span>{c.data.summary}</span>
            </a>
          ))}
        </div>
      </nav>
    )}

    <div class="cs-body">
      <Content components={mdxComponents} />
    </div>
  </article>

  <nav class="cs-next" aria-label="More work">
    {parent ? (
      <>
        <p class="eyebrow">Part of</p>
        <a class="next-link" href={url(parent)}>{parent.data.title}</a>
        <div class="sibs">{siblings.map(s => <a class="arrow-link" href={url(s)}>{s.data.title}</a>)}</div>
      </>
    ) : next && (
      <>
        <p class="eyebrow">Next project</p>
        <a class="next-link" href={url(next)}>{next.data.title}</a>
        <a class="arrow-link" href="/#work">All work</a>
      </>
    )}
  </nav>
</Base>
